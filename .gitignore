# Dependencies lock files - keep these for reproducible builds
package-lock.json

# Node modules - always excluded
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output directories - excluded from repo
output/
dist/

# Generated static assets - NOT committed to repo, generated during build
# These are created from npm packages during CI/CD build
theme/apache/static/css/bootstrap.min.css
theme/apache/static/js/bootstrap.bundle.min.js
theme/apache/static/css/custom.css
theme/apache/static/js/doc-enhancements.js
theme/apache/static/js/highlight.min.js
theme/apache/static/js/highlight/highlight.js
theme/apache/static/css/highlight.css
theme/apache/static/css/bootstrap-icons.css
theme/apache/static/fonts/
theme/apache/static/integrity.json
theme/apache/static/bundles/

# Generated static build artifact shadows under scripts/
scripts/theme/apache/static/

# Python cache
*.pyc
__pycache__/

# Python virtual environments
venv/
.venv/
env/
.env/

# Requirements lock files - keep for reproducibility
requirements-lock.txt

# Source maps and temporary files
*.map
*.tmp
*.temp
*.temp.*

# Environment files
.env
.env.local
.env.*.local

# IDE configs
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs (not committed)
logs/

# Test coverage
coverage/
.nyc_output/

# Cache directories
.cache/
.parcel-cache/
.next/
.nuxt/
.antlr/
.bundler/